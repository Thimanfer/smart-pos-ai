# Smart POS AI Environment Variables

# API Configuration
API_VERSION=1.0.0
API_TITLE=Smart POS AI API
API_DESCRIPTION=Enterprise POS System with AI Forecasting

# Database
DATABASE_URL=sqlite:///./smart_pos.db
ECHO_SQL=false

# Security
SECRET_KEY=change-this-in-production-with-a-strong-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "http://127.0.0.1:3000"]

# AI/ML Configuration
FORECAST_DAYS=30
MIN_HISTORICAL_DAYS=30

# Redis (optional for caching)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=INFO
